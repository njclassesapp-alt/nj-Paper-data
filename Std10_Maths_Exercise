    { chapter: 5, marks: 3, q: "સમાંતર શ્રેણીના પ્રથમ અને અંતિમ પદ અનુક્રમે 17 અને 350 છે. જો સામાન્ય તફાવત 9 હોય, તો તેમાં કેટલાં પદ હશે અને તેમનો સરવાળો કેટલો થશે?" },
    { chapter: 5, marks: 3, q: "જે સમાંતર શ્રેણીમાં d = 7 અને 22મું પદ 149 હોય, તેના પ્રથમ 22 પદોનો સરવાળો શોધો." },
    { chapter: 5, marks: 3, q: "જે સમાંતર શ્રેણીનું બીજું અને ત્રીજું પદ અનુક્રમે 14 અને 18 હોય, તેના પ્રથમ 51 પદોનો સરવાળો શોધો." },
    { chapter: 5, marks: 3, q: "જો સમાંતર શ્રેણીના પ્રથમ 7 પદોનો સરવાળો 49 અને 17 પદોનો સરવાળો 289 હોય, તો તેના પ્રથમ n પદોનો સરવાળો શોધો." },
    { chapter: 5, marks: 3, q: "જો a_n = 3 + 4n હોય, તો સાબિત કરો કે a_1, a_2, ..., a_n સમાંતર શ્રેણી બનાવે છે. વળી, પ્રથમ 15 પદોનો સરવાળો શોધો." },
    { chapter: 5, marks: 3, q: "જો a_n = 9 - 5n હોય, તો સાબિત કરો કે a_1, a_2, ..., a_n સમાંતર શ્રેણી બનાવે છે. વળી, પ્રથમ 15 પદોનો સરવાળો શોધો." },
    { chapter: 5, marks: 3, q: "જો સમાંતર શ્રેણીના પ્રથમ n પદોનો સરવાળો 4n - n² હોય, તો તેનું પ્રથમ પદ કયું હશે? પ્રથમ બે પદોનો સરવાળો કેટલો હશે? બીજું પદ કયું હશે? આ જ રીતે 3જું, 10મું અને nમું પદ શોધો." },
    { chapter: 5, marks: 2, q: "6 વડે વિભાજ્ય પ્રથમ 40 ધન પૂર્ણાંકોનો સરવાળો શોધો." },
    { chapter: 5, marks: 2, q: "8 ના પ્રથમ 15 ગુણિતોનો સરવાળો શોધો." },
    { chapter: 5, marks: 2, q: "0 અને 50 વચ્ચેની અયુગ્મ (એકી) સંખ્યાઓનો સરવાળો શોધો." },
    { chapter: 5, marks: 4, q: "નિર્માણ કામ માટે થયેલ કરારમાં નિશ્ચિત તારીખ કરતાં વિલંબથી પૂરું થતા કામ માટે નીચે પ્રમાણેના દંડની જોગવાઈ છે: પ્રથમ દિવસ માટે રૂ. 200, બીજા દિવસ માટે રૂ. 250, ત્રીજા દિવસ માટે રૂ. 300 વગેરે. પ્રત્યેક દિવસ માટે દંડની રકમ આગળના દિવસ કરતાં રૂ. 50 વધુ છે. જો કૉન્ટ્રાક્ટર 30 દિવસનો વિલંબ કરે, તો તેણે ભરવી પડતી દંડની રકમ શોધો." },
    { chapter: 5, marks: 4, q: "કોઈ એક શાળાના વિદ્યાર્થીઓના સમગ્ર શૈક્ષણિક પ્રદર્શન માટે અપાતા 7 ઇનામો માટે કુલ રૂ. 700 ની જોગવાઈ કરવાની છે. જો પ્રત્યેક ઇનામ આગળના ઇનામ કરતાં રૂ. 20 ઓછું હોય, તો પ્રત્યેક ઇનામની રકમ શોધો." },
    { chapter: 5, marks: 3, q: "એક શાળામાં વિદ્યાર્થીઓ વાયુ પ્રદૂષણ ઓછું કરવા માટે શાળાની અંદર અને બહાર વૃક્ષ વાવવાનું વિચારે છે. એવું નક્કી કરાયું કે પ્રત્યેક ધોરણનો પ્રત્યેક વિભાગ તે જે ધોરણમાં ભણતા હોય તેટલાં વૃક્ષ વાવશે. દા.ત. ધોરણ 1 નો વિભાગ 1 વૃક્ષ, ધોરણ 2 નો વિભાગ 2 વૃક્ષ અને આવું ધોરણ 12 સુધી ચાલશે. દરેક ધોરણમાં ત્રણ વિભાગ છે. આ વિદ્યાર્થીઓ દ્વારા કેટલાં વૃક્ષનું વાવેતર થશે?" },

    // ---------------- પ્રકરણ 6: ત્રિકોણ ----------------
    { chapter: 6, marks: 1, q: "ખાલી જગ્યા પૂરો: બધાં વર્તુળો _______ છે. (એકરૂપ / સમરૂપ)" },
    { chapter: 6, marks: 1, q: "ખાલી જગ્યા પૂરો: બધા ચોરસ _______ છે. (સમરૂપ / એકરૂપ)" },
    { chapter: 6, marks: 1, q: "ખાલી જગ્યા પૂરો: બધા _______ ત્રિકોણો સમરૂપ છે. (સમદ્વિબાજુ / સમબાજુ)" },
    { chapter: 6, marks: 1, q: "જો બે બહુકોણના અનુરૂપ ખૂણાઓ _______ હોય અને તેમની અનુરૂપ બાજુઓ _______ હોય, તો સમાન સંખ્યાની બાજુઓવાળા બે બહુકોણો સમરૂપ છે. (સમાન, સમપ્રમાણમાં)" },
    { chapter: 6, marks: 2, q: "નીચેની જોડીઓનાં બે જુદા-જુદા ઉદાહરણ આપો: (i) સમરૂપ આકૃતિઓ (ii) સમરૂપ ન હોય તેવી આકૃતિઓ." },
    { chapter: 6, marks: 2, q: "જો ત્રિકોણ ABC માં DE || BC હોય અને DE, AB ને D માં તથા AC ને E માં છેદે છે. જો AD = 1.5 સેમી, DB = 3 સેમી અને AE = 1 સેમી હોય, તો EC શોધો." },
    { chapter: 6, marks: 2, q: "જો ત્રિકોણ ABC માં DE || BC હોય અને DE, AB ને D માં તથા AC ને E માં છેદે છે. જો AD/DB = 3/5 અને AC = 5.6 સેમી હોય, તો AE શોધો." },
    { chapter: 6, marks: 2, q: "બિંદુઓ E અને F એ ત્રિકોણ PQR ની બાજુઓ અનુક્રમે PQ અને PR પર આવેલા છે. જો PE = 3.9 સેમી, EQ = 3 સેમી, PF = 3.6 સેમી અને FR = 2.4 સેમી હોય, તો ચકાસો કે EF || QR છે કે નહિ." },
    { chapter: 6, marks: 3, q: "સાબિત કરો કે: જો કોઈ ત્રિકોણની એક બાજુને સમાંતર દોરેલી રેખા બાકીની બે બાજુઓને ભિન્ન બિંદુઓમાં છેદે, તો તે બે બાજુઓ પર કપાતા રેખાખંડો તે બાજુઓનું સમાન ગુણોત્તરમાં વિભાજન કરે છે. (થેલ્સનો પ્રમેય)" },
    { chapter: 6, marks: 3, q: "આકૃતિમાં જો LM || CB અને LN || CD હોય, તો સાબિત કરો કે (AM / AB) = (AN / AD) છે." },
    { chapter: 6, marks: 3, q: "આકૃતિમાં DE || AC અને DF || AE છે. સાબિત કરો કે (BF / FE) = (BE / EC)." },
    { chapter: 6, marks: 3, q: "આકૃતિમાં A, B અને C અનુક્રમે OP, OQ અને OR પર આવેલાં એવાં બિંદુઓ છે કે જેથી AB || PQ અને AC || PR થાય. સાબિત કરો કે BC || QR." },
    { chapter: 6, marks: 3, q: "સમલંબ ચતુષ્કોણ ABCD માં AB || DC છે અને તેના વિકર્ણો એકબીજાને બિંદુ O માં છેદે છે. સાબિત કરો કે (AO / BO) = (CO / DO) છે." },
    { chapter: 6, marks: 3, q: "જો ચતુષ્કોણ ABCD ના વિકર્ણો એકબીજાને બિંદુ O માં એવી રીતે છેદે કે જેથી (AO / BO) = (CO / DO) થાય, તો સાબિત કરો કે ABCD સમલંબ ચતુષ્કોણ છે." },
    { chapter: 6, marks: 3, q: "જો ત્રિકોણ ABC અને PQR માં (AB / PQ) = (BC / QR) = (CA / RP) હોય, તો ત્રિકોણની સમરૂપતા માટેની શરત જણાવો અને સમરૂપતાને સંકેતમાં લખો." },
    { chapter: 6, marks: 2, q: "આપેલ આકૃતિમાં ΔODC ~ ΔOBA, ∠BOC = 125° અને ∠CDO = 70° છે. ∠DOC, ∠DCO અને ∠OAB શોધો." },
    { chapter: 6, marks: 3, q: "સમલંબ ચતુષ્કોણ ABCD માં AB || DC છે. તેના વિકર્ણો AC અને BD એકબીજાને O બિંદુમાં છેદે છે. બે ત્રિકોણની સમરૂપતાનો ઉપયોગ કરીને સાબિત કરો કે (OA / OC) = (OB / OD)." },
    { chapter: 6, marks: 3, q: "આકૃતિમાં (QR / QS) = (QT / PR) અને ∠1 = ∠2 છે. સાબિત કરો કે ΔPQS ~ ΔTQR." },
    { chapter: 6, marks: 3, q: "ΔPQR ની બાજુઓ PR અને QR પર અનુક્રમે બિંદુઓ S અને T એવાં છે કે જેથી ∠P = ∠RTS. સાબિત કરો કે ΔRPQ ~ ΔRTS." },
    { chapter: 6, marks: 3, q: "આકૃતિમાં જો ΔABE ≅ ΔACD હોય, તો સાબિત કરો કે ΔADE ~ ΔABC." },

    // ---------------- પ્રકરણ 7: યામ ભૂમિતિ ----------------
    { chapter: 7, marks: 2, q: "નીચે આપેલ બિંદુઓની જોડ વચ્ચેનું અંતર શોધો: (2, 3) અને (4, 1)" },
    { chapter: 7, marks: 2, q: "નીચે આપેલ બિંદુઓની જોડ વચ્ચેનું અંતર શોધો: (-5, 7) અને (-1, 3)" },
    { chapter: 7, marks: 2, q: "નીચે આપેલ બિંદુઓની જોડ વચ્ચેનું અંતર શોધો: (a, b) અને (-a, -b)" },
    { chapter: 7, marks: 2, q: "બિંદુઓ (0, 0) અને (36, 15) વચ્ચેનું અંતર શોધો." },
    { chapter: 7, marks: 2, q: "બિંદુઓ (1, 5), (2, 3) અને (-2, -11) સમરેખ છે કે નહીં તે નક્કી કરો." },
    { chapter: 7, marks: 2, q: "ચકાસો કે (5, -2), (6, 4) અને (7, -2) એ સમદ્વિબાજુ ત્રિકોણનાં શિરોબિંદુઓ છે." },
    { chapter: 7, marks: 3, q: "એક વર્ગખંડમાં ચાર મિત્રો આપેલ આકૃતિમાં દર્શાવેલ બિંદુઓ A, B, C અને D દ્વારા દર્શાવેલ સ્થાન પર બેઠા છે. ચંપા અને ચમેલી વર્ગમાં આવીને થોડી મિનિટોના અવલોકન બાદ ચંપાએ ચમેલીને પૂછ્યું કે 'શું તું એવું માને છે કે ABCD ચોરસ છે?' અંતર સૂત્રનો ઉપયોગ કરી કોણ સાચું છે તે શોધો." },
    { chapter: 7, marks: 3, q: "નીચે દર્શાવેલાં બિંદુઓથી જો ચતુષ્કોણ રચાતો હોય, તો તેનો પ્રકાર જણાવો અને તમારા જવાબ માટે કારણ આપો: (-1, -2), (1, 0), (-1, 2), (-3, 0)" },
    { chapter: 7, marks: 3, q: "નીચે દર્શાવેલાં બિંદુઓથી જો ચતુષ્કોણ રચાતો હોય, તો તેનો પ્રકાર જણાવો: (-3, 5), (3, 1), (0, 3), (-1, -4)" },
    { chapter: 7, marks: 3, q: "નીચે દર્શાવેલાં બિંદુઓથી જો ચતુષ્કોણ રચાતો હોય, તો તેનો પ્રકાર જણાવો: (4, 5), (7, 6), (4, 3), (1, 2)" },
    { chapter: 7, marks: 2, q: "જે બિંદુઓ (2, -5) અને (-2, 9) થી સમાન અંતરે હોય તેવું x-અક્ષ પરનું બિંદુ શોધો." },
    { chapter: 7, marks: 3, q: "બિંદુઓ P(2, -3) અને Q(10, y) વચ્ચેનું અંતર 10 એકમ હોય, તો y ની કિંમત શોધો." },
    { chapter: 7, marks: 3, q: "જો Q(0, 1) એ P(5, -3) અને R(x, 6) થી સમાન અંતરે હોય, તો x ની કિંમત શોધો. અંતર QR અને PR પણ શોધો." },
    { chapter: 7, marks: 3, q: "x અને y વચ્ચેનો એવો સંબંધ મેળવો કે જેથી બિંદુ (x, y) એ બિંદુઓ (3, 6) અને (-3, 4) થી સમાન અંતરે હોય." },
    { chapter: 7, marks: 3, q: "બિંદુઓ (-1, 7) અને (4, -3) ને જોડતા રેખાખંડનું 2:3 ગુણોત્તરમાં વિભાજન કરતા બિંદુના યામ શોધો." },
    { chapter: 7, marks: 3, q: "બિંદુઓ (4, -1) અને (-2, -3) ને જોડતા રેખાખંડના ત્રિભાગ બિંદુઓના યામ શોધો." },
    { chapter: 7, marks: 3, q: "તમારી શાળાના લંબચોરસ આકારના મેદાન ABCD માં રમતગમત પ્રવૃત્તિઓ યોજવામાં આવી છે. ચૉક પાવડરની મદદથી 1 મીટરના અંતરે રેખાઓ દોરેલી છે. AD પર પ્રત્યેક 1 મીટરના અંતરે હોય તેવા 100 કૂંડાં મૂક્યા છે. નિહારિકા બીજી હરોળમાં દોડે છે અને AD ના 1/4 ભાગનું અંતર કાપે છે અને ત્યાં લીલો ધ્વજ ફરકાવે છે. પ્રીત આઠમી હરોળમાં AD ના 1/5 ભાગનું અંતર કાપે છે અને લાલ ધ્વજ ફરકાવે છે. બંને ધ્વજ વચ્ચેનું અંતર શોધો. જો રશ્મિએ આ બંને ધ્વજને જોડતા રેખાખંડના મધ્યબિંદુ પર વાદળી ધ્વજ ફરકાવવાનો હોય, તો તેણે ધ્વજ ક્યાં ફરકાવવો જોઈએ?" },
    { chapter: 7, marks: 3, q: "બિંદુઓ (-3, 10) અને (6, -8) ને જોડતા રેખાખંડનું બિંદુ (-1, 6) કયા ગુણોત્તરમાં વિભાજન કરશે?" },
    { chapter: 7, marks: 3, q: "x-અક્ષ બિંદુઓ A(1, -5) અને B(-4, 5) ને જોડતા રેખાખંડનું કયા ગુણોત્તરમાં વિભાજન કરે છે તે શોધો. વિભાજન બિંદુના યામ પણ શોધો." },
    { chapter: 7, marks: 3, q: "જો (1, 2), (4, y), (x, 6) અને (3, 5) એ એક સમાંતરબાજુ ચતુષ્કોણનાં ક્રમિક શિરોબિંદુઓ હોય, તો x અને y શોધો." },
    { chapter: 7, marks: 2, q: "A એ વર્તુળનો વ્યાસ છે. વર્તુળનું કેન્દ્ર (2, -3) છે અને B ના યામ (1, 4) છે, તો બિંદુ A ના યામ શોધો." },
    { chapter: 7, marks: 3, q: "જો A અને B અનુક્રમે (-2, -2) અને (2, -4) હોય, જેથી AP = (3/7)AB થાય અને બિંદુ P રેખાખંડ AB પર આવેલ હોય, તો બિંદુ P ના યામ શોધો." },
    { chapter: 7, marks: 3, q: "બિંદુઓ A(-2, 2) અને B(2, 8) ને જોડતા રેખાખંડનું ચાર સમાન ભાગમાં વિભાજન કરતા બિંદુઓના યામ શોધો." },
    { chapter: 7, marks: 3, q: "સમબાજુ ચતુષ્કોણનાં ક્રમિક શિરોબિંદુઓ (3, 0), (4, 5), (-1, 4) અને (-2, -1) હોય, તો તેનું ક્ષેત્રફળ શોધો. (સૂચના: સમબાજુ ચતુષ્કોણનું ક્ષેત્રફળ = 1/2 × તેના વિકર્ણોનો ગુણાકાર)" },

    // ---------------- પ્રકરણ 8: ત્રિકોણમિતિનો પરિચય ----------------
    { chapter: 8, marks: 2, q: "ત્રિકોણ ABC માં, ખૂણો B કાટખૂણો છે. જો AB = 24 સેમી, BC = 7 સેમી હોય, તો sin A અને cos A શોધો." },
    { chapter: 8, marks: 2, q: "ત્રિકોણ ABC માં, ખૂણો B કાટખૂણો છે. જો AB = 24 સેમી, BC = 7 સેમી હોય, તો sin C અને cos C શોધો." },
    { chapter: 8, marks: 2, q: "આકૃતિમાં, ત્રિકોણ PQR માં ખૂણો Q કાટખૂણો છે, PQ = 12 સેમી અને PR = 13 સેમી છે, તો tan P - cot R શોધો." },
    { chapter: 8, marks: 2, q: "જો sin A = 3/4 હોય, તો cos A અને tan A ની ગણતરી કરો." },
    { chapter: 8, marks: 2, q: "જો 15 cot A = 8 હોય, તો sin A અને sec A શોધો." },
    { chapter: 8, marks: 2, q: "જો sec θ = 13/12 હોય, તો બાકીના બધા જ ત્રિકોણમિતીય ગુણોત્તરો શોધો." },
    { chapter: 8, marks: 3, q: "જો ખૂણો A અને ખૂણો B એવા લઘુકોણો હોય કે જેથી cos A = cos B થાય, તો સાબિત કરો કે ખૂણો A = ખૂણો B." },
    { chapter: 8, marks: 3, q: "જો cot θ = 7/8 હોય, તો ( (1 + sin θ)(1 - sin θ) ) / ( (1 + cos θ)(1 - cos θ) ) ની કિંમત શોધો." },
    { chapter: 8, marks: 2, q: "જો cot θ = 7/8 હોય, તો cot² θ ની કિંમત શોધો." },
    { chapter: 8, marks: 3, q: "જો 3 cot A = 4 હોય, તો ચકાસો કે (1 - tan² A) / (1 + tan² A) = cos² A - sin² A છે કે નહિ." },
    { chapter: 8, marks: 3, q: "ત્રિકોણ ABC માં ખૂણો B કાટખૂણો છે. જો tan A = 1/√3 હોય, તો sin A cos C + cos A sin C ની કિંમત શોધો." },
    { chapter: 8, marks: 3, q: "ત્રિકોણ ABC માં ખૂણો B કાટખૂણો છે. જો tan A = 1/√3 હોય, તો cos A cos C - sin A sin C ની કિંમત શોધો." },
    { chapter: 8, marks: 3, q: "ત્રિકોણ PQR માં ખૂણો Q કાટખૂણો છે. જો PR + QR = 25 સેમી અને PQ = 5 સેમી હોય, તો sin P, cos P અને tan P શોધો." },
    { chapter: 8, marks: 1, q: "નીચેના વિધાનો સત્ય છે કે અસત્ય તે જણાવો. તમારા જવાબની યથાર્થતા ચકાસો: tan A નું મૂલ્ય હંમેશાં 1 કરતાં ઓછું હોય છે." },
    { chapter: 8, marks: 1, q: "નીચેના વિધાનો સત્ય છે કે અસત્ય તે જણાવો: A ના કોઈ માપ માટે sec A = 12/5 સત્ય છે." },
    { chapter: 8, marks: 1, q: "નીચેના વિધાનો સત્ય છે કે અસત્ય તે જણાવો: ખૂણા A ના કોસિકન્ટ (cosecant) ને સંક્ષિપ્તમાં cos A તરીકે લખાય છે." },
    { chapter: 8, marks: 1, q: "નીચેના વિધાનો સત્ય છે કે અસત્ય તે જણાવો: cot અને A નો ગુણાકાર cot A છે." },
    { chapter: 8, marks: 1, q: "નીચેના વિધાનો સત્ય છે કે અસત્ય તે જણાવો: θ માપવાળા કોઈ એક ખૂણા માટે sin θ = 4/3 શક્ય છે." },
    { chapter: 8, marks: 2, q: "કિંમત શોધો: sin 60° cos 30° + sin 30° cos 60°" },
    { chapter: 8, marks: 2, q: "કિંમત શોધો: 2 tan² 45° + cos² 30° - sin² 60°" },
    { chapter: 8, marks: 3, q: "કિંમત શોધો: (cos 45°) / (sec 30° + cosec 30°)" },
    { chapter: 8, marks: 3, q: "કિંમત શોધો: (sin 30° + tan 45° - cosec 60°) / (sec 30° + cos 60° + cot 45°)" },
    { chapter: 8, marks: 3, q: "કિંમત શોધો: (5 cos² 60° + 4 sec² 30° - tan² 45°) / (sin² 30° + cos² 30°)" },
    { chapter: 8, marks: 2, q: "સાચો વિકલ્પ પસંદ કરો: 2 tan 30° / (1 + tan² 30°) = ? (A) sin 60° (B) cos 60° (C) tan 60° (D) sin 30°" },
    { chapter: 8, marks: 2, q: "સાચો વિકલ્પ પસંદ કરો: (1 - tan² 45°) / (1 + tan² 45°) = ? (A) tan 90° (B) 1 (C) sin 45° (D) 0" },
    { chapter: 8, marks: 2, q: "સાચો વિકલ્પ પસંદ કરો: જ્યારે A = _______ હોય, ત્યારે sin 2A = 2 sin A સત્ય હોય. (A) 0° (B) 30° (C) 45° (D) 60°" },
    { chapter: 8, marks: 2, q: "સાચો વિકલ્પ પસંદ કરો: 2 tan 30° / (1 - tan² 30°) = ? (A) cos 60° (B) sin 60° (C) tan 60° (D) sin 30°" },
    { chapter: 8, marks: 3, q: "જો tan (A + B) = √3 અને tan (A - B) = 1/√3, 0° < A + B ≤ 90°, A > B હોય, તો A અને B શોધો." },
    { chapter: 8, marks: 1, q: "નીચેના વિધાનો સત્ય છે કે નહિ તે જણાવો. કારણ આપો: sin (A + B) = sin A + sin B" },
    { chapter: 8, marks: 1, q: "નીચેના વિધાનો સત્ય છે કે નહિ તે જણાવો. કારણ આપો: જેમ θ નું મૂલ્ય વધે તેમ sin θ નું મૂલ્ય વધે છે." },
    { chapter: 8, marks: 1, q: "નીચેના વિધાનો સત્ય છે કે નહિ તે જણાવો. કારણ આપો: જેમ θ નું મૂલ્ય વધે તેમ cos θ નું મૂલ્ય વધે છે." },
    { chapter: 8, marks: 1, q: "નીચેના વિધાનો સત્ય છે કે નહિ તે જણાવો. કારણ આપો: θ ના દરેક મૂલ્ય માટે sin θ = cos θ થાય છે." },
    { chapter: 8, marks: 1, q: "નીચેના વિધાનો સત્ય છે કે નહિ તે જણાવો. કારણ આપો: A = 0° માટે cot A અવ્યાખ્યાયિત છે." },
    { chapter: 8, marks: 2, q: "કિંમત શોધો: 9 sec² A - 9 tan² A" },
    { chapter: 8, marks: 2, q: "કિંમત શોધો: (1 + tan θ + sec θ)(1 + cot θ - cosec θ)" },
    { chapter: 8, marks: 2, q: "કિંમત શોધો: (sec A + tan A)(1 - sin A)" },
    { chapter: 8, marks: 2, q: "કિંમત શોધો: (1 + tan² A) / (1 + cot² A)" },
    { chapter: 8, marks: 3, q: "સાબિત કરો કે: (cosec θ - cot θ)² = (1 - cos θ) / (1 + cos θ)" },
    { chapter: 8, marks: 3, q: "સાબિત કરો કે: (cos A) / (1 + sin A) + (1 + sin A) / (cos A) = 2 sec A" },
    { chapter: 8, marks: 4, q: "સાબિત કરો કે: (tan θ) / (1 - cot θ) + (cot θ) / (1 - tan θ) = 1 + sec θ cosec θ" },
    { chapter: 8, marks: 3, q: "સાબિત કરો કે: (1 + sec A) / sec A = sin² A / (1 - cos A)" },
    { chapter: 8, marks: 4, q: "નિત્યસમ cosec² A = 1 + cot² A નો ઉપયોગ કરીને સાબિત કરો કે: (cos A - sin A + 1) / (cos A + sin A - 1) = cosec A + cot A" },
    { chapter: 8, marks: 3, q: "સાબિત કરો કે: √( (1 + sin A) / (1 - sin A) ) = sec A + tan A" },
    { chapter: 8, marks: 3, q: "સાબિત કરો કે: (sin θ - 2 sin³ θ) / (2 cos³ θ - cos θ) = tan θ" },
    { chapter: 8, marks: 3, q: "સાબિત કરો કે: (sin A + cosec A)² + (cos A + sec A)² = 7 + tan² A + cot² A" },
    { chapter: 8, marks: 3, q: "સાબિત કરો કે: (cosec A - sin A)(sec A - cos A) = 1 / (tan A + cot A)" },
    { chapter: 8, marks: 3, q: "સાબિત કરો કે: (1 + tan² A) / (1 + cot² A) = ( (1 - tan A) / (1 - cot A) )² = tan² A" },
    // ---------------- પ્રકરણ 9: ત્રિકોણમિતિનો ઉપયોગ ----------------
    { chapter: 9, marks: 3, q: "સર્કસના તંબુમાં જમીન સાથે શિરોલંબ સ્થિતિમાં રહેલા થાંભલાની ટોચથી જમીન સાથે ખેંચીને બાંધેલા 20 મીટર લાંબા દોરડા પર એક કલાકાર ચઢી રહ્યો છે. જો દોરડું જમીન સાથે 30° ના માપનો ખૂણો બનાવે, તો થાંભલાની ઊંચાઈ શોધો." },
    { chapter: 9, marks: 4, q: "વાવાઝોડાને કારણે એક ઝાડ એ રીતે ભાંગીને વળી જાય છે, જેથી તેની ટોચ જમીનને અડકે છે અને જમીન સાથે 30° માપનો ખૂણો બનાવે છે. ઝાડની ટોચ જમીનને અડકે તે બિંદુ અને ઝાડના થડ વચ્ચેનું અંતર 8 મીટર છે. તો ઝાડની ઊંચાઈ શોધો." },
    { chapter: 9, marks: 3, q: "એક ઠેકેદાર બાળકોને રમવા માટે બગીચામાં બે લપસણી લગાવવા માંગે છે. 5 વર્ષથી ઓછી ઉંમરનાં બાળકો માટે જમીનથી 1.5 મીટરની ઊંચાઈ પર રહે અને જમીન સાથે 30° નો ખૂણો બનાવે તેવી લપસણી પસંદ કરે છે. જ્યારે તેનાથી વધારે ઉંમરનાં બાળકો માટે 3 મીટરની ઊંચાઈ પરથી સીધો ઢાળ હોય અને જમીન સાથે 60° નો ખૂણો બનાવતી હોય તેવી લપસણી પસંદ કરે છે. બંને લપસણીની લંબાઈ શોધો." },
    { chapter: 9, marks: 3, q: "ટાવરના પાયાથી 30 મીટર દૂર રહેલા જમીન પરના એક બિંદુથી ટાવરની ટોચના ઉત્સેધકોણનું માપ 30° છે. તો ટાવરની ઊંચાઈ શોધો." },
    { chapter: 9, marks: 3, q: "એક પતંગ જમીનથી 60 મીટરની ઊંચાઈ પર ઊડી રહેલ છે. આ પતંગની દોરીનો એક છેડો ક્ષણભર માટે જમીન પરના એક બિંદુ સાથે બાંધેલ છે. આ સ્થિતિમાં દોરીનો જમીન સાથેનો ખૂણો 60° છે. જો દોરીમાં કોઈ ઢીલ નથી તેવું માની લેવામાં આવે, તો દોરીની લંબાઈ શોધો." },
    { chapter: 9, marks: 4, q: "1.5 મીટર ઊંચો એક છોકરો એક 30 મીટર ઊંચી ઇમારતથી કોઈક અંતરે ઊભેલ છે. જ્યારે તે ઇમારત તરફ ચાલવાનું શરૂ કરે છે ત્યારે કેટલીક વાર પછી તેની આંખથી ઇમારતની ટોચના ઉત્સેધકોણનું માપ 30° થી વધીને 60° થાય છે, તો તે ઇમારત તરફ કેટલું અંતર ચાલ્યો હશે તે શોધો." },
    { chapter: 9, marks: 4, q: "જમીન પર આવેલા એક બિંદુથી 20 મીટર ઊંચી ઇમારતની ટોચ પર રહેલા એક સંચાર ટાવરના તળિયા અને ટોચના ઉત્સેધકોણનાં માપ અનુક્રમે 45° અને 60° છે. તો ટાવરની ઊંચાઈ શોધો." },
    { chapter: 9, marks: 4, q: "એક પેડેસ્ટલ પર 1.6 મીટર ઊંચી એક પ્રતિમા ગોઠવેલ છે. જમીન પરના એક બિંદુએથી પ્રતિમાની ટોચના ઉત્સેધકોણનું માપ 60° અને પેડેસ્ટલની ટોચના ઉત્સેધકોણનું માપ 45° છે. તો પેડેસ્ટલની ઊંચાઈ શોધો." },
    { chapter: 9, marks: 4, q: "એક ટાવરના તળિયેથી એક મકાનની ટોચના ઉત્સેધકોણનું માપ 30° છે અને મકાનના તળિયેથી ટાવરની ટોચના ઉત્સેધકોણનું માપ 60° છે. જો ટાવરની ઊંચાઈ 50 મીટર હોય, તો મકાનની ઊંચાઈ શોધો." },
    { chapter: 9, marks: 4, q: "સમાન ઊંચાઈના બે સ્તંભ 80 મીટર પહોળા માર્ગની બંને બાજુએ સામસામે આવેલા છે. માર્ગ પર વચ્ચે આવેલ કોઈ એક બિંદુએથી બંને સ્તંભની ટોચના ઉત્સેધકોણનાં માપ 60° અને 30° જણાય છે. તો દરેક સ્તંભની ઊંચાઈ અને બંને સ્તંભનું નિરીક્ષણ બિંદુથી અંતર શોધો." },
    { chapter: 9, marks: 4, q: "નહેરના એક કિનારે ટીવીનો ટાવર શિરોલંબ ઊભો કરવામાં આવ્યો છે. ટાવરની સામેના બીજા કિનારા પર રહેલા એક બિંદુથી ટાવરની ટોચનો ઉત્સેધકોણ 60° છે. ટાવરના તળિયા અને નિરીક્ષણ બિંદુને જોડતી રેખા પર આવેલ અને નિરીક્ષણ બિંદુથી 20 મીટર દૂર બીજા એક બિંદુથી ટાવરની ટોચના ઉત્સેધકોણનું માપ 30° છે. તો ટાવરની ઊંચાઈ અને નહેરની પહોળાઈ શોધો." },
    { chapter: 9, marks: 4, q: "7 મીટર ઊંચી ઇમારત પરથી એક કેબલ ટાવરની ટોચનો ઉત્સેધકોણ 60° અને ટાવરના તળિયાનો અવસેધકોણ 45° છે. તો ટાવરની ઊંચાઈ શોધો." },
    { chapter: 9, marks: 4, q: "દરિયાની સપાટીથી 75 મીટર ઊંચી દીવાદાંડી પરથી અવલોકન કરતાં, સમુદ્રમાં આવતાં બે વહાણના અવસેધકોણનાં માપ 30° અને 45° માલૂમ પડે છે. જો એક વહાણ બીજા વહાણની બરાબર પાછળ હોય અને બંને વહાણો દીવાદાંડીની એક જ બાજુ પર આવેલાં હોય, તો બંને વહાણો વચ્ચેનું અંતર શોધો." },
    { chapter: 9, marks: 4, q: "1.2 મીટર ઊંચી એક છોકરી જમીનથી 88.2 મીટર ઊંચાઈ પર પવનને કારણે સમક્ષિતિજ રેખામાં ઊડતું એક બલૂન જુએ છે. કોઈ એક સમયે છોકરીની આંખથી બલૂનનો ઉત્સેધકોણ 60° છે. થોડા સમય બાદ ઉત્સેધકોણ ઘટીને 30° થાય છે. તો આ સમયગાળા દરમિયાન બલૂને કાપેલું અંતર શોધો." },
    { chapter: 9, marks: 4, q: "એક સુરેખ માર્ગ ટાવરના તળિયા સુધી જાય છે. ટાવરની ટોચ પર ઊભેલ એક વ્યક્તિ એક કારને 30° ના અવસેધકોણથી જુએ છે, જે ટાવરના તળિયા તરફ અચળ ઝડપથી આવી રહી છે. 6 સેકન્ડ પછી કારનો અવસેધકોણ 60° થાય છે. તો કારને ટાવરના તળિયા સુધી પહોંચતા કેટલો સમય લાગશે?" },

    // ---------------- પ્રકરણ 10: વર્તુળ ----------------
    { chapter: 10, marks: 1, q: "વર્તુળને કેટલા સ્પર્શક હોય છે?" },
    { chapter: 10, marks: 1, q: "ખાલી જગ્યા પૂરો: સ્પર્શક વર્તુળને ....... બિંદુમાં છેદે છે." },
    { chapter: 10, marks: 1, q: "ખાલી જગ્યા પૂરો: વર્તુળને બે બિંદુમાં છેદતી રેખાને ....... કહે છે." },
    { chapter: 10, marks: 1, q: "ખાલી જગ્યા પૂરો: વર્તુળને વધુમાં વધુ ....... સમાંતર સ્પર્શક હોઈ શકે." },
    { chapter: 10, marks: 1, q: "ખાલી જગ્યા પૂરો: વર્તુળ અને સ્પર્શકના સામાન્ય બિંદુને ....... કહે છે." },
    { chapter: 10, marks: 2, q: "5 સેમી ત્રિજ્યાવાળા વર્તુળના કોઈ બિંદુ P આગળ દોરેલો એક સ્પર્શક PQ, કેન્દ્ર O માંથી પસાર થતી રેખાને Q બિંદુએ છેદે છે. જો OQ = 12 સેમી હોય, તો PQ ની લંબાઈ શોધો." },
    { chapter: 10, marks: 2, q: "એક વર્તુળ દોરો અને વર્તુળના સમતલમાં આપેલી કોઈ એક રેખાને સમાંતર હોય તેવી બે રેખાઓ દોરો, જે પૈકી એક વર્તુળનો સ્પર્શક હોય અને બીજી વર્તુળની છેદિકા હોય." },
    { chapter: 10, marks: 2, q: "બિંદુ Q માંથી દોરેલા વર્તુળના સ્પર્શકની લંબાઈ 24 સેમી અને વર્તુળના કેન્દ્રથી તેનું અંતર 25 સેમી હોય, તો વર્તુળની ત્રિજ્યા શોધો." },
    { chapter: 10, marks: 2, q: "જો TP અને TQ એ કેન્દ્ર O વાળા વર્તુળના સ્પર્શકો એવી રીતે છે કે જેથી ∠POQ = 110° થાય, તો ∠PTQ નું માપ શોધો." },
    { chapter: 10, marks: 2, q: "જો O કેન્દ્રવાળા વર્તુળને બિંદુ P માંથી દોરેલા સ્પર્શકો PA અને PB વચ્ચે 80° નો ખૂણો રચાતો હોય, તો ∠POA શોધો." },
    { chapter: 10, marks: 3, q: "સાબિત કરો કે વર્તુળના વ્યાસના અંત્યબિંદુઓએ દોરેલા સ્પર્શકો સમાંતર હોય છે." },
    { chapter: 10, marks: 3, q: "સાબિત કરો કે વર્તુળના સ્પર્શકના સ્પર્શબિંદુમાંથી દોરેલો લંબ વર્તુળના કેન્દ્રમાંથી પસાર થાય છે." },
    { chapter: 10, marks: 2, q: "વર્તુળના કેન્દ્રથી 5 સેમી અંતરે આવેલા બિંદુ A થી દોરેલા સ્પર્શકની લંબાઈ 4 સેમી છે, તો વર્તુળની ત્રિજ્યા શોધો." },
    { chapter: 10, marks: 3, q: "બે સમકેન્દ્રી વર્તુળોની ત્રિજ્યાઓ 5 સેમી અને 3 સેમી છે. મોટા વર્તુળની જીવા નાના વર્તુળને સ્પર્શે છે, તો તેની લંબાઈ શોધો." },
    { chapter: 10, marks: 3, q: "ચતુષ્કોણ ABCD એક વર્તુળને પરિગત છે. સાબિત કરો કે AB + CD = AD + BC." },
    { chapter: 10, marks: 4, q: "XY અને X'Y' એ O કેન્દ્રવાળા વર્તુળના બે સમાંતર સ્પર્શકો છે અને સ્પર્શબિંદુ C આગળ દોરેલો ત્રીજો સ્પર્શક XY ને A માં અને X'Y' ને B માં છેદે છે. સાબિત કરો કે ∠AOB = 90°." },
    { chapter: 10, marks: 3, q: "સાબિત કરો કે વર્તુળના બહારના બિંદુમાંથી દોરેલા સ્પર્શકો વચ્ચેનો ખૂણો અને સ્પર્શબિંદુઓને કેન્દ્ર સાથે જોડતા રેખાખંડ વચ્ચેનો ખૂણો એકબીજાના પૂરકકોણ હોય છે." },
    { chapter: 10, marks: 4, q: "4 સેમી ત્રિજ્યાવાળા વર્તુળને પરિગત ત્રિકોણ ABC એ રીતે દોરેલો છે કે રેખાખંડ BD અને DC ની લંબાઈ અનુક્રમે 8 સેમી અને 6 સેમી થાય. જો ત્રિકોણ ABC નું ક્ષેત્રફળ 84 સેમી² હોય, તો બાજુઓ AB અને AC શોધો." },
    { chapter: 10, marks: 3, q: "સાબિત કરો કે વર્તુળને પરિગત ચતુષ્કોણની સામસામેની બાજુઓ વર્તુળના કેન્દ્ર આગળ પૂરકકોણ આંતરે છે." },

    // ---------------- પ્રકરણ 11: વર્તુળ સંબંધિત ક્ષેત્રફળ ----------------
    { chapter: 11, marks: 2, q: "6 સેમી ત્રિજ્યાવાળા વર્તુળના વૃત્તાંશ દ્વારા કેન્દ્ર આગળ 60° નો ખૂણો બને છે, તો તે વૃત્તાંશનું ક્ષેત્રફળ શોધો." },
    { chapter: 11, marks: 2, q: "22 સેમી પરિઘવાળા વર્તુળના ચતુર્થાંશનું ક્ષેત્રફળ શોધો." },
    { chapter: 11, marks: 2, q: "એક ઘડિયાળના મિનિટકાંટાની લંબાઈ 14 સેમી છે. 5 મિનિટમાં મિનિટકાંટો જેટલું ક્ષેત્રફળ આવરે તે શોધો." },
    { chapter: 11, marks: 3, q: "10 સેમી ત્રિજ્યાવાળા વર્તુળની જીવા કેન્દ્ર આગળ કાટખૂણો આંતરે છે. તેને અનુરૂપ (i) લઘુવૃત્તખંડ (ii) ગુરુવૃત્તાંશનું ક્ષેત્રફળ શોધો. (π = 3.14 લો)" },
    { chapter: 11, marks: 3, q: "21 સેમી ત્રિજ્યાવાળા વર્તુળનું એક ચાપ કેન્દ્ર આગળ 60° નો ખૂણો આંતરે છે. તેને અનુરૂપ (i) ચાપની લંબાઈ (ii) ચાપ દ્વારા બનતા વૃત્તાંશનું ક્ષેત્રફળ (iii) અનુરૂપ જીવા દ્વારા બનતા વૃત્તખંડનું ક્ષેત્રફળ શોધો." },
    { chapter: 11, marks: 3, q: "15 સેમી ત્રિજ્યાવાળા વર્તુળની જીવા કેન્દ્ર આગળ 60° નો ખૂણો આંતરે છે. તેને અનુરૂપ લઘુવૃત્તખંડ અને ગુરુવૃત્તખંડનું ક્ષેત્રફળ શોધો. (π = 3.14 અને √3 = 1.73 લો)" },
    { chapter: 11, marks: 3, q: "12 સેમી ત્રિજ્યાવાળા વર્તુળની જીવા કેન્દ્ર આગળ 120° નો ખૂણો આંતરે છે. તેને અનુરૂપ વૃત્તખંડનું ક્ષેત્રફળ શોધો. (π = 3.14 અને √3 = 1.73 લો)" },
    { chapter: 11, marks: 3, q: "15 મીટર બાજુવાળા ચોરસ આકારના ઘાસના મેદાનના એક ખૂણે ઘોડાને 5 મીટર લાંબા દોરડાથી ખીલા સાથે બાંધેલ છે. (i) ઘોડો મેદાનના જેટલા ભાગમાં ચરી શકે તેનું ક્ષેત્રફળ શોધો. (ii) દોરડું 5 મીટરની બદલે 10 મીટર લાંબું રાખવામાં આવે તો ચરવાના ક્ષેત્રફળમાં થતો વધારો શોધો. (π = 3.14 લો)" },
    { chapter: 11, marks: 3, q: "ચાંદીના તારથી 35 મિમી વ્યાસવાળું એક વર્તુળાકાર બ્રોચ બનાવેલ છે. આકૃતિમાં દર્શાવ્યા પ્રમાણે તેને 10 સમાન વૃત્તાંશમાં વિભાજિત કરતા 5 વ્યાસ પણ તારથી બનાવેલા છે. તો (i) જરૂરી ચાંદીના તારની કુલ લંબાઈ (ii) બ્રોચના પ્રત્યેક વૃત્તાંશનું ક્ષેત્રફળ શોધો." },
    { chapter: 11, marks: 3, q: "એક છત્રીમાં સમાન અંતરે 8 સળિયા આવેલા છે. છત્રીને 45 સેમી ત્રિજ્યાવાળું એક સપાટ વર્તુળ ધારીને, છત્રીના બે ક્રમિક સળિયા વચ્ચેના ભાગનું ક્ષેત્રફળ શોધો." },
    { chapter: 11, marks: 3, q: "એક મોટરકારના બે વાઇપર છે, જે ક્યારેય એકબીજા પર આચ્છાદિત થતા નથી. પ્રત્યેક વાઇપરની લંબાઈ 25 સેમી છે અને તે 115° ના ખૂણા સુધી ફરીને સફાઈ કરી શકે છે. બંને વાઇપરના પ્રત્યેક સફાઈ-વખતે સાફ થતા વિસ્તારનું કુલ ક્ષેત્રફળ શોધો." },
    { chapter: 11, marks: 3, q: "પાણીની નીચેના ખડકોની ચેતવણી આપવા એક દીવાદાંડી લાલ રંગનો પ્રકાશ 16.5 કિમી અંતર સુધી 80° ના વૃત્તાંશના ખૂણામાં ફેલાવે છે. સમુદ્રના જેટલા વિસ્તારમાં જહાજને ચેતવણી મળતી હોય તે વિસ્તારનું ક્ષેત્રફળ શોધો. (π = 3.14 લો)" },
    { chapter: 11, marks: 3, q: "એક ગોળ મેજપોશ પર 6 સમાન ભાત બનાવેલી છે. જો મેજપોશની ત્રિજ્યા 28 સેમી હોય, તો 1 ચોરસ સેમીના રૂ. 0.35 ના દરે આ ભાત બનાવવાનો ખર્ચ શોધો. (√3 = 1.7 લો)" },
    { chapter: 11, marks: 1, q: "સાચો વિકલ્પ પસંદ કરો: R ત્રિજ્યાવાળા વર્તુળના વૃત્તાંશનો ખૂણો p° હોય, તો તે વૃત્તાંશનું ક્ષેત્રફળ નીચેનામાંથી કયું છે? (A) (p/180) × 2πR (B) (p/180) × πR² (C) (p/360) × 2πR (D) (p/720) × 2πR²" },

    // ---------------- પ્રકરણ 12: પૃષ્ઠફળ અને ઘનફળ ----------------
    { chapter: 12, marks: 2, q: "બે ઘન પૈકી પ્રત્યેકનું ઘનફળ 64 સેમી³ હોય તેવા બે ઘનને જોડવાથી બનતા લંબઘનનું પૃષ્ઠફળ શોધો." },
    { chapter: 12, marks: 3, q: "એક અર્ધગોલક પર એક પોલો નળાકાર બેસાડેલો હોય તેવું એક પાત્ર છે. અર્ધગોલકનો વ્યાસ 14 સેમી છે અને પાત્રની કુલ ઊંચાઈ 13 સેમી છે. પાત્રની અંદરની સપાટીનું પૃષ્ઠફળ શોધો." },
    { chapter: 12, marks: 3, q: "એક રમકડું 3.5 સેમી ત્રિજ્યાવાળા અર્ધગોલક પર તેટલી જ ત્રિજ્યાવાળો શંકુ લગાવેલો હોય તેવા આકારનું છે. રમકડાની કુલ ઊંચાઈ 15.5 સેમી હોય, તો રમકડાનું કુલ પૃષ્ઠફળ શોધો." },
    { chapter: 12, marks: 3, q: "7 સેમી બાજુના માપવાળા સમઘનની ઉપર અર્ધગોલક મૂકેલો છે. તો અર્ધગોલકનો મહત્તમ વ્યાસ શું હોઈ શકે? આ રીતે બનેલા પદાર્થનું કુલ પૃષ્ઠફળ શોધો." },
    { chapter: 12, marks: 3, q: "એક સમઘન લાકડાના ટુકડાના એક પૃષ્ઠમાંથી એક અર્ધગોલક કાપવામાં આવે છે. અર્ધગોલકનો વ્યાસ l એ સમઘનની બાજુના માપ બરાબર છે. બાકી પદાર્થનું કુલ પૃષ્ઠફળ શોધો." },
    { chapter: 12, marks: 3, q: "દવાની એક કૅપ્સ્યૂલનો આકાર નળાકારની બંને બાજુએ અર્ધગોલક લગાડેલો હોય તેવો છે. કૅપ્સ્યૂલની કુલ લંબાઈ 14 મિમી છે અને તેનો વ્યાસ 5 મિમી છે. તો કૅપ્સ્યૂલનું કુલ પૃષ્ઠફળ શોધો." },
    { chapter: 12, marks: 4, q: "એક તંબુનો આકાર નળાકાર ઉપર શંકુ મૂકેલો હોય તેવો છે. જો નળાકાર ભાગની ઊંચાઈ અને વ્યાસ અનુક્રમે 2.1 મીટર અને 4 મીટર હોય, તથા ઉપરના ભાગની તિર્યક ઊંચાઈ (ત્રાંસી ઊંચાઈ) 2.8 મીટર હોય, તો આ તંબુ બનાવવા વપરાતા કેનવાસનું ક્ષેત્રફળ શોધો. જો કેનવાસનો ભાવ રૂ. 500 પ્રતિ મીટર² હોય, તો તેમાં વપરાતા કેનવાસની કુલ કિંમત શોધો." },
    { chapter: 12, marks: 3, q: "2.4 સેમી ઊંચાઈ અને 1.4 સેમી વ્યાસવાળા એક નળાકારમાંથી તેટલી જ ઊંચાઈ અને વ્યાસવાળો શંકુ કાપી લેવામાં આવે છે. તો વધેલા પદાર્થનું કુલ પૃષ્ઠફળ નજીકના સેમી² માં શોધો." },
    { chapter: 12, marks: 3, q: "લાકડાના નળાકારમાંથી બંને બાજુએથી અર્ધગોલક કાઢીને એક લાકડાનો શો-પીસ બનાવ્યો છે. જો નળાકારની ઊંચાઈ 10 સેમી અને પાયાની ત્રિજ્યા 3.5 સેમી હોય, તો શો-પીસનું કુલ પૃષ્ઠફળ શોધો." },
    { chapter: 12, marks: 2, q: "એક ઘન પદાર્થ એ 1 સેમી ત્રિજ્યા ધરાવતા અર્ધગોલક ઉપર તેટલી જ ત્રિજ્યાવાળો શંકુ ગોઠવીને બનાવેલો છે. શંકુની ઊંચાઈ તેની ત્રિજ્યા જેટલી જ છે. તો આ ઘન પદાર્થનું ઘનફળ π ના પદમાં શોધો." },
    { chapter: 12, marks: 3, q: "એન્જિનિયરિંગના વિદ્યાર્થી રશેલને નળાકારના બંને છેડે પાતળી એલ્યુમિનિયમની શીટમાંથી બનેલા શંકુ બેસાડી એક નમૂનો તૈયાર કરવાનું કહેવામાં આવ્યું. નમૂનાનો વ્યાસ 3 સેમી અને લંબાઈ 12 સેમી છે. જો શંકુની ઊંચાઈ 2 સેમી હોય, તો રશેલે બનાવેલ નમૂનામાં કેટલી હવા સમાશે તે શોધો." },
    { chapter: 12, marks: 4, q: "એક ગુલાબજાંબુમાં તેના કદના આશરે 30% જેટલી ખાંડની ચાસણી છે. દરેક ગુલાબજાંબુનો આકાર નળાકારના બંને છેડે અર્ધગોલક લગાવ્યા હોય તેવો છે. તેની કુલ લંબાઈ 5 સેમી અને વ્યાસ 2.8 સેમી છે. આવા 45 ગુલાબજાંબુમાં આશરે કેટલી ચાસણી હશે તે શોધો." },
    { chapter: 12, marks: 3, q: "એક લાકડાનું લંબઘન પેન-સ્ટેન્ડ 4 શંકુ આકારના છિદ્રવાળું બનાવેલું છે. લંબઘનના માપ 15 સેમી × 10 સેમી × 3.5 સેમી છે. છિદ્રવાળા દરેક ભાગની ત્રિજ્યા 0.5 સેમી અને ઊંડાઈ 1.4 સેમી છે. લાકડાના આ પેન-સ્ટેન્ડનું ઘનફળ શોધો." },
    { chapter: 12, marks: 3, q: "એક વાસણનું સ્વરૂપ ઊંધા શંકુ જેવું છે. તેની ઊંચાઈ 8 સેમી અને ઉપરના ખુલ્લા ભાગની ત્રિજ્યા 5 સેમી છે. તે ઉપરની ધાર સુધી પાણીથી ભરેલું છે. જ્યારે વાસણમાં 0.5 સેમી ત્રિજ્યાવાળી સીસાની ગોળીઓ નાખવામાં આવે છે, ત્યારે એક ચતુર્થાંશ (1/4) જેટલું પાણી બહાર આવે છે. તો વાસણમાં નાખેલી સીસાની ગોળીઓની સંખ્યા શોધો." },
    { chapter: 12, marks: 4, q: "એક લોખંડના સ્તંભનો નળાકાર ભાગ 220 સેમી ઊંચાઈ અને 24 સેમી વ્યાસ ધરાવે છે. તેની ઉપર 60 સેમી ઊંચાઈ અને 8 સેમી ત્રિજ્યાવાળો બીજો નળાકાર મૂકેલો છે. સ્તંભનું દળ શોધો. (આપેલ છે કે 1 સેમી³ લોખંડનું દળ આશરે 8 ગ્રામ છે. π = 3.14 લો)" },
    { chapter: 12, marks: 3, q: "એક નક્કર ગોળા અને શંકુ બંનેની ત્રિજ્યા સમાન છે તથા તેમના ઘનફળ પણ સમાન છે. તો શંકુની ઊંચાઈ અને ત્રિજ્યાનો ગુણોત્તર શોધો." }, // (આ પ્રકારના પ્રશ્નો પ્રેક્ટિસમાં પૂછાય છે)
